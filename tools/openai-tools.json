              }
            }
          }
        },
        "required": ["name"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "modify_blueprint_graph",
      "description": "Модифицировать существующий граф. На вход — JSON текущего графа (из песочницы Export → JSON) + инструкция что изменить. Возвращает обновлённый Begin Object текст.",
      "parameters": {
        "type": "object",
        "properties": {
          "currentGraphJSON": {"type": "string", "description": "Экспорт текущего графа в JSON (из песочницы)"},
          "instruction": {"type": "string", "description": "Что изменить, например: добавь проверку IsValid перед вызовом F_UpdateGraphics"},
          "preserveGuids": {"type": "boolean", "default": true, "description": "Сохранять GUID неизменённых нод"}
        },
        "required": ["currentGraphJSON", "instruction"]
      }
    }
  }
