      "name": "create_behavior_tree",
      "description": "Создать Behavior Tree + Blackboard. Аналог NeoStack Behaviour Trees.",
      "parameters": {
        "type": "object",
        "properties": {
          "name": {"type": "string", "description": "Имя BT, например BT_EnemyAI"},
          "blackboardKeys": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {"type": "string"},
