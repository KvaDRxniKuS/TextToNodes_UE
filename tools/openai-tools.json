[
  {
    "type": "function",
    "function": {
      "name": "create_blueprint",
      "description": "Создать Blueprint ассет (Actor, Component, Variables, Graph). Генерирует валидный UE текст Begin Object для вставки через Ctrl+V. Аналог NeoStack Blueprints. ВАЖНО: генерируй по prompt/system-prompt.md и реестру data/ue-functions.json (поля lib/macro/struct, запрещённые классы), затем ОБЯЗАТЕЛЬНО проверь текст командой node src/validate.js и исправь все ошибки.",
      "parameters": {
        "type": "object",
        "properties": {
          "name": {"type": "string", "description": "Имя ассета, например BP_HealthPickup"},
          "parentClass": {"type": "string", "enum": ["Actor", "Pawn", "Character", "ActorComponent", "Object"], "default": "Actor"},
          "components": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {"type": "string"},
                "type": {"type": "string", "enum": ["StaticMeshComponent", "SphereCollision", "BoxCollision", "SkeletalMeshComponent", "CameraComponent", "ArrowComponent"]}
              },
              "required": ["name", "type"]
            }
          },
          "variables": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {"type": "string"},
                "type": {"type": "string", "enum": ["float", "int", "bool", "String", "Vector", "Rotator", "Object"]},
                "defaultValue": {"type": "string"},
                "isEditable": {"type": "boolean", "default": true}
              },
              "required": ["name", "type"]
            }
          },
          "graphDescription": {"type": "string", "description": "Текстовое описание логики графа, например: если StaticMu > DynamicMu то вызвать F_UpdateGraphics иначе Set StaticMu"},
          "graphNodes": {
            "type": "array",
            "description": "Опционально: точные ноды. Если не указано — сгенерируется из graphDescription через реестр KismetMathLibrary",
            "items": {
              "type": "object",
              "description": "Нода графа (полная схема — src/schema.json)",
              "properties": {
                "id": {"type": "string"},
                "className": {"type": "string", "enum": ["BlueprintGraph.K2Node_VariableGet", "BlueprintGraph.K2Node_VariableSet", "BlueprintGraph.K2Node_PromotableOperator", "BlueprintGraph.K2Node_IfThenElse", "BlueprintGraph.K2Node_ExecutionSequence", "BlueprintGraph.K2Node_SwitchInteger", "BlueprintGraph.K2Node_SwitchString", "BlueprintGraph.K2Node_SwitchEnum", "BlueprintGraph.K2Node_MakeStruct", "BlueprintGraph.K2Node_BreakStruct", "BlueprintGraph.K2Node_MacroInstance", "BlueprintGraph.K2Node_CallFunction", "BlueprintGraph.K2Node_CallArrayFunction", "BlueprintGraph.K2Node_Select", "BlueprintGraph.K2Node_Knot", "UnrealEd.EdGraphNode_Comment"]},
                "pos": {"type": "object", "properties": {"x": {"type": "number"}, "y": {"type": "number"}}},
                "varName": {"type": "string"},
                "funcName": {"type": "string"},
                "memberParent": {"type": "string"},
                "operationName": {"type": "string"},
                "structType": {"type": "string"},
                "macroGraph": {"type": "string"},
                "commentText": {"type": "string"},
                "pins": {"type": "array", "items": {"type": "object"}}
              },
              "required": ["id", "className", "pins"]
            }
          }
        },
        "required": ["name", "graphDescription"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "create_material",
      "description": "Создать Material ассет. Генерирует MaterialExpression ноды (TextureSample, Multiply, Lerp, etc). Аналог NeoStack Materials.",
      "parameters": {
        "type": "object",
        "properties": {
          "name": {"type": "string", "description": "Имя материала, например M_Master_Health"},
          "domain": {"type": "string", "enum": ["Surface", "DeferredDecal", "LightFunction", "PostProcess"], "default": "Surface"},
          "blendMode": {"type": "string", "enum": ["Opaque", "Masked", "Translucent", "Additive"], "default": "Opaque"},
          "expressions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {"type": "string", "enum": ["TextureSample", "Constant3Vector", "Multiply", "Add", "Lerp", "Fresnel", "Panner", "Time"]},
                "params": {"type": "object"}
              }
            }
          },
          "connectTo": {"type": "string", "description": "Куда подключить результат, например BaseColor, EmissiveColor, Opacity"}
        },
        "required": ["name", "expressions"]
      }
    }
  },
